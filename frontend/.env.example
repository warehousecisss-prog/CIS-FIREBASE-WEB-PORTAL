# ============================================================================
# Frontend configuration -- copy to `frontend/.env` and fill in.
# ============================================================================
#
# WHERE TO GET THESE
# Firebase console -> Project settings -> General -> "Your apps" -> Web app.
# If no web app exists yet, add one (the "</>" button). The console shows a
# `firebaseConfig` object; these four values come straight out of it.
#
# ARE THESE SECRET? No.
# A Firebase web config IDENTIFIES a project; it does not grant access to one.
# Access is decided server-side -- functions/auth.js verifies the ID token and
# checks the email domain, and answers 401 to anything else. Google publishes
# these values in their own quickstarts. They live in .env so an environment is
# not hardcoded, not because they are credentials.
#
# The real secrets are in functions/.env (TRELLO_TOKEN, SMTP_PASS,
# TRELLO_API_SECRET). Those are a different file and a different risk.
#
# NOTE: Vite only exposes variables prefixed VITE_ to the browser, and it
# inlines them at BUILD time -- change one and you must rebuild, not just
# reload.
# ============================================================================

# apiKey from firebaseConfig
VITE_FIREBASE_API_KEY=

# authDomain -- usually <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# projectId -- the real project ID, NOT the display name.
# Also used to build the emulator URL during local development.
VITE_FIREBASE_PROJECT_ID=

# appId from firebaseConfig -- looks like 1:123456789:web:abc123
VITE_FIREBASE_APP_ID=
