{
  "name": "functions",
  "description": "Cloud Functions for CIS Warehouse Portal",
  "scripts": {
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:parity": "node test/parity_Shared_Classifiers.js && node test/parity_Service_Dates.js && node test/parity_Service_Conversions.js && node test/parity_Aging.js && node test/parity_Service_Assembly.js && node test/parity_CommitAtomic.js && node test/parity_Rollup.js && node test/parity_Webhook.js && node test/parity_Sync.js",
    "test:parity:rollup": "node test/parity_Rollup.js",
    "test:parity:webhook": "node test/parity_Webhook.js",
    "test:parity:sync": "node test/parity_Sync.js",
    "test:parity:assembly": "node test/parity_Service_Assembly.js",
    "test:parity:commit": "node test/parity_CommitAtomic.js",
    "test:parity:aging": "node test/parity_Aging.js",
    "test:parity:conversions": "node test/parity_Service_Conversions.js",
    "test:parity:dates": "node test/parity_Service_Dates.js",
    "test:routes": "node test/routes_contract.js",
    "test:lock": "node test/lock_contract.js",
    "test:webhook": "node test/webhook_contract.js",
    "test:lock:emulator": "firebase emulators:exec --only firestore --project cis-warehouse-portal \"node test/lock_contract.js\"",
    "test": "npm run test:parity && npm run test:routes && npm run test:lock && npm run test:webhook"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^133.0.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.1"
  },
  "private": true
}
