# ============================================================================
# CIS Warehouse Portal -- Cloud Functions runtime configuration
# ============================================================================
# Copy to `functions/.env` and fill in. The Firebase CLI loads functions/.env
# automatically for both `firebase emulators:start` and `firebase deploy`;
# functions/.env.<projectId> overrides it per project.
#
# functions/.env is gitignored. This example file carries DUMMY values only --
# never a real credential.
#
# Every key is declared in functions/config.js with a description and the
# SRC/src line it came from. Read config values through that module
# (config.get / config.require / config.flag / config.list), never
# process.env directly.
#
# Values marked REQUIRED are named in a warning at every cold start when unset,
# and throw an explicit error at the point of use.
# ----------------------------------------------------------------------------


# --- Google Sheets ----------------------------------------------------------
# REQUIRED. The operational workbook. Apps Script could fall back to the bound
# spreadsheet; Cloud Functions cannot, so there is no fallback here.
BATCH_SHEET_ID=0000000000000000000000000000000000000000000


# --- Auth (port-only; no Apps Script ancestor) ------------------------------
# REQUIRED. Comma-separated Google Workspace domains permitted to call the API.
# The allowlist failing closed is the point: an empty list rejects everyone
# rather than admitting anyone with a Google account.
ALLOWED_EMAIL_DOMAINS=example.com

# Optional. Individual addresses allowed in addition to the domains above.
ALLOWED_EMAILS=

# Emulator-only bypass. Honoured ONLY when FUNCTIONS_EMULATOR=true, which the
# Functions emulator sets for you; deployed code ignores this entirely, so
# leaving it set to true here cannot open production.
AUTH_DISABLED=true

# Identity written into Audit_Log while the bypass above is active. Kept
# deliberately non-routable so local writes are obvious in the sheet.
DEV_OPERATOR_EMAIL=emulator-operator@localhost


# --- Trello credentials -----------------------------------------------------
# REQUIRED. TRELLO_API_KEY / TRELLO_API_TOKEN are accepted as aliases, matching
# the dual naming in SRC/src/Service_Write.js:1565-1566.
TRELLO_KEY=dummy-trello-key
TRELLO_TOKEN=dummy-trello-token

# Optional. Defaults to the organisation ID hardcoded in the original.
TRELLO_ORG_ID=649c7882ed36c7969285c5d3

# Optional. Member ID of the dedicated automation Trello account. When unset,
# ETA-override detection falls back to comparing against lastAutoDue instead of
# comparing idMemberCreator (SCHEMA 4F) -- that fallback is the documented
# behaviour, not a degraded one.
# NOTE: the original WRITES this back via identifyTrelloBotAccount(). Setting it
# here covers the read half only; the write-back needs a real state store.
TRELLO_BOT_MEMBER_ID=


# --- Trello board / list IDs (SCHEMA section 2) -----------------------------
# All optional -- config.js carries the same defaults the original hardcoded.
# Set them only to point a non-production deployment at different boards.
INBOUND_PO_BOARD_ID=649c805bad63086ff6689611
INBOUND_NICOLE_BOARD_ID=64c286cd0d581563f72d58c0
BURLINGTON_OUTBOUND_BOARD_ID=649c7dd6690130fe8ef3689a
OUTBOUND_BOARD_ID=66bcf93dd63eecdb2d4e91e7
BURLINGTON_OUTBOUND_TO_BE_SHIPPED=649c7dd664d470bbe01f6fc2


# --- External spreadsheets --------------------------------------------------
BURLINGTON_SHEET_SYNC=10l6c37PE54MWug1C1HQEUtz1dP-s5x2btHDGcxNI2JM


# --- FedEx ------------------------------------------------------------------
# RENAMED FROM THE ORIGINAL. SRC/src/Fedex_Master_Script.js:12-13 calls the
# Track API credentials just CLIENT_ID / CLIENT_SECRET, which is far too generic
# for a process environment. The FEDEX_-prefixed names are primary; the bare
# names still work as aliases, so existing Script Property values can be lifted
# across unchanged.
FEDEX_CLIENT_ID=dummy-fedex-track-client-id
FEDEX_CLIENT_SECRET=dummy-fedex-track-client-secret

# Separate credential pair from the Track API above -- do not reuse (SCHEMA 8).
FEDEX_RATES_KEY=dummy-fedex-rates-key
FEDEX_RATES_SECRET=dummy-fedex-rates-secret

# FEDEX_ACCOUNT_NUMBER is accepted as an alias. The "000000000" default is
# preserved from the original: the Rates API rejects it per-row, which fails
# loudly rather than silently.
FEDEX_ACCOUNT=000000000

CIS_ZIPCODE=34997


# --- RXO --------------------------------------------------------------------
RXO_CLIENT_ID=dummy-rxo-client-id
RXO_CLIENT_SECRET=dummy-rxo-client-secret
RXO_API_KEY=dummy-rxo-api-key
RXO_SCOPE=
RXO_PARTNER_CODE=

# Compared as the literal string "true" (SRC/src/Service_RXO.js:59).
RXO_DRY_RUN=true


# --- Webhook ----------------------------------------------------------------
# Optional BY DESIGN -- leave EMPTY until the Render proxy actually appends
# ?k=<secret>. Setting it early silently rejects every real webhook, and a
# dropped webhook is unrecoverable until the next scheduled sync
# (SCHEMA 63, AUDIT D2).
WEBHOOK_HOP_SECRET=


# --- HTS / tariff tooling (not ported yet) ----------------------------------
HTS_FILE_ID=
GLOBAL_SURCHARGE_RATE=0.00


# --- OneDrive sync (not ported yet; known broken upstream, SCHEMA 19) -------
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ITEM_ID=


# --- Email (port-only; the original used MailApp, which needed no config) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dummy-smtp-user
SMTP_PASS=dummy-smtp-pass
SMTP_FROM=Warehouse Portal <noreply@example.com>


# ----------------------------------------------------------------------------
# NOT CONFIG -- do not add these here.
# The original writes these back at runtime with setProperty, so they need a
# real store (Firestore) when their owning script is ported:
#   WEBHOOK_ERRORS_LAST_ROW    Webhook_Receiver.js:175
#   FR_WATCH_SEEN_DOCS         checkFederalRegisterForTariffChanges.js:47
#   LAST_SYNCED_MODIFIED_TIME  OneDrive_Graph_Sync.gs.js:149
#   TRELLO_BOT_MEMBER_ID       write-back half only (read half is above)
#
# STAKEHOLDER_EMAILS is also NOT a config key -- it lives in the workbook's
# Config tab and is read from there (SRC/src/Service_Write.js:1376).
# ----------------------------------------------------------------------------
